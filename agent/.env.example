# OpenAI (LangGraph "think" model)
OPENAI_API_KEY=

# Medplum — https://app.medplum.com → Project Admin → Client Applications
MEDPLUM_BASE_URL=https://api.medplum.com/
MEDPLUM_CLIENT_ID=
MEDPLUM_CLIENT_SECRET=
# Optional: pin a demo patient id after first seed
MEDPLUM_DEMO_PATIENT_ID=

# Moss — https://www.moss.dev portal → Project ID + Key
MOSS_PROJECT_ID=
MOSS_PROJECT_KEY=
MOSS_INDEX_NAME=patient-history

# Deepgram — https://console.deepgram.com
DEEPGRAM_API_KEY=

# Stedi — test API key (portal → API Keys → Test)
# https://www.stedi.com/docs/healthcare/test-mode
STEDI_API_KEY=

# Open Wearables — unified Whoop / Oura / Fitbit / Garmin / Apple Health / …
# https://openwearables.io/docs  |  self-host: github.com/the-momentum/open-wearables
# Auth header: X-Open-Wearables-API-Key
OPEN_WEARABLES_BASE_URL=http://localhost:8000
OPEN_WEARABLES_API_KEY=
OPEN_WEARABLES_USER_ID=

# Whoop direct (real strap, no Open Wearables instance required)
# App: https://developer-dashboard.whoop.com/ → create Team → create App
# Register this exact redirect URI on the app:
#   http://localhost:8080/wearables/whoop/callback
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_REDIRECT_URI=http://localhost:8080/wearables/whoop/callback
# Only the scopes we read. Whoop rejects the whole authorization request with invalid_scope if
# the app is not granted something you ask for, so do not add scopes speculatively.
WHOOP_SCOPE=offline read:recovery read:sleep

# FlareCheck secure photo capture (public URLs for phone + web)
PUBLIC_APP_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:8080
CAPTURE_TOKEN_SECRET=

# Runtime
# mock = local fixtures / in-memory FHIR
# live = real Medplum (+ Moss when keyed)
AGENT_MODE=mock
OPENAI_MODEL=gpt-4o-mini
